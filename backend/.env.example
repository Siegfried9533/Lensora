# Sao chép file này thành .env và điền giá trị thật
# cp .env.example .env

# ============================================================
# PostgreSQL
# ============================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/LensoraDB
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# Dùng cho docker-compose (postgres container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=LensoraDB
DB_PORT=5433

# ============================================================
# JWT
# ============================================================
APP_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
APP_JWT_EXPIRATION_MS=86400000

# ============================================================
# Frontend URL (dùng trong link email)
# ============================================================
APP_FRONTEND_URL=http://localhost:8081

# ============================================================
# Email
# Dev local: dùng MailHog  →  docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
# Production: đổi sang SMTP Gmail / SendGrid / ...
# ============================================================
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=no-reply@lensora.local
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS=false

# Gmail example:
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your_email@gmail.com
# SPRING_MAIL_PASSWORD=your_gmail_app_password
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_SMTP_STARTTLS=true

# ============================================================
# GHN Shipping API
# Lấy token tại: https://sso.ghn.vn
# ============================================================
APP_GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/
APP_GHN_SHOP_ID=0
APP_GHN_TOKEN=your_ghn_token_here
APP_GHN_DISTRICT_ID=0

# ============================================================
# MoMo Payment (Sandbox)
# Đăng ký tại: https://business.momo.vn/
# ============================================================
APP_MOMO_PARTNER_CODE=your_momo_partner_code
APP_MOMO_ACCESS_KEY=your_momo_access_key
APP_MOMO_SECRET_KEY=your_momo_secret_key
APP_MOMO_URL=https://test-payment.momo.vn
APP_MOMO_REDIRECT_URL=http://localhost:8081/payment/momo/redirect
APP_MOMO_IPN_URL=http://localhost:8080/api/payment/momo/ipn

# ============================================================
# DeepSeek AI API
# Lấy API key tại: https://platform.deepseek.com/api_keys
# ============================================================
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_api_key_here