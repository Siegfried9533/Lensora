<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         Media Shop type styles
         (1) uppercase + tracking-tight for top-level titles
         (2) uppercase + tracking-widest for eyebrow labels
         (3) bold 18-24sp for card titles
         ============================================================ -->

    <style name="Text.Display" parent="">
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="Text.Heading" parent="">
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="Text.CardTitle" parent="">
        <item name="android:textSize">@dimen/text_card_title</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Eyebrow" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_body</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="Text.Muted" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Text.Price" parent="">
        <item name="android:textSize">@dimen/text_card_title</item>
        <item name="android:textColor">@color/orange</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.PriceLarge" parent="">
        <item name="android:textSize">@dimen/text_price_lg</item>
        <item name="android:textColor">@color/orange</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Mono" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- ============================================================
         Buttons
         ============================================================ -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Button.Outline" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ============================================================
         Inputs
         ============================================================ -->
    <style name="Input.Box" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/border_dark</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxBackgroundColor">@color/ms_surface</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

</resources>
