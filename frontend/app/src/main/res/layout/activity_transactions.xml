<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_secondary"
    android:orientation="vertical">

    <TextView
        style="@style/Text.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingTop="28dp"
        android:paddingBottom="20dp"
        android:text="@string/tab_transactions" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:layout_marginHorizontal="@dimen/page_padding"
        android:background="@drawable/bg_segment_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_orders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_active"
            android:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/tx_orders"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rentals"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_inactive"
            android:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/tx_rentals"
            android:textAllCaps="false"
            android:textColor="@color/nav_inactive"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_orders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="80dp" />

        <TextView
            android:id="@+id/txt_orders_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/tx_empty_orders"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_rentals"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="80dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_rentals_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/tx_empty_rentals"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@color/bg_dark_primary"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemRippleColor="@android:color/transparent"
        app:itemTextColor="@color/bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
