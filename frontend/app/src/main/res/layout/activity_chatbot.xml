<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_secondary"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/bg_dark_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chat_header_button"
            android:contentDescription="@string/action_back"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_chatbot_icon_circle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_robot"
                app:tint="@color/orange" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chatbot_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_online_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="@string/chatbot_status_active"
                    android:textColor="@color/green_400"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_chatbot_sparkle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chat_header_button"
            android:contentDescription="@string/chatbot_title"
            android:padding="10dp"
            android:src="@drawable/ic_sparkles"
            app:tint="@color/orange" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/txt_empty"
            style="@style/Text.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/chatbot_empty" />
    </FrameLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark_secondary"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp"
        app:singleLine="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_1"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/chatbot_suggest_find_camera"
            android:textColor="@color/orange"
            android:textSize="12sp"
            android:textStyle="bold"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@android:color/transparent"
            app:chipCornerRadius="20dp"
            app:chipStrokeColor="@color/orange"
            app:chipStrokeWidth="1dp"
            app:closeIconVisible="false"
            app:ensureMinTouchTargetSize="false"
            app:rippleColor="@color/orange_20" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_2"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/chatbot_suggest_rental_policy"
            android:textColor="@color/orange"
            android:textSize="12sp"
            android:textStyle="bold"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@android:color/transparent"
            app:chipCornerRadius="20dp"
            app:chipStrokeColor="@color/orange"
            app:chipStrokeWidth="1dp"
            app:closeIconVisible="false"
            app:ensureMinTouchTargetSize="false"
            app:rippleColor="@color/orange_20" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_3"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/chatbot_suggest_rental_items"
            android:textColor="@color/orange"
            android:textSize="12sp"
            android:textStyle="bold"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@android:color/transparent"
            app:chipCornerRadius="20dp"
            app:chipStrokeColor="@color/orange"
            app:chipStrokeWidth="1dp"
            app:closeIconVisible="false"
            app:ensureMinTouchTargetSize="false"
            app:rippleColor="@color/orange_20" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_4"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/chatbot_suggest_newest"
            android:textColor="@color/orange"
            android:textSize="12sp"
            android:textStyle="bold"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@android:color/transparent"
            app:chipCornerRadius="20dp"
            app:chipStrokeColor="@color/orange"
            app:chipStrokeWidth="1dp"
            app:closeIconVisible="false"
            app:ensureMinTouchTargetSize="false"
            app:rippleColor="@color/orange_20" />
    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/bg_dark_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <EditText
            android:id="@+id/input_message"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:hint="@string/chatbot_input_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:paddingHorizontal="18dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/nav_inactive"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_send_circle"
            android:contentDescription="@string/chatbot_send"
            android:padding="13dp"
            android:src="@drawable/ic_send"
            app:tint="@color/nav_inactive" />
    </LinearLayout>
</LinearLayout>
